<?xml version="1.0" encoding="utf-8"?>
<!-- What a project that uses Emu.Frontend.Win32 imports, wherever it sits: beside the solution, or
     in an EmuLib submodule. Import it in the project's PropertySheets group, add ProjectReferences
     to Emu.Core.vcxproj and Emu.Frontend.Win32.vcxproj, and import Emu.Frontend.Win32.targets after
     Microsoft.Cpp.targets (README.md, "Using it from a project"):

       <Import Project="..\EmuLib\Emu.Frontend.Win32\Emu.Frontend.Win32.props" />

     It imports Emu.Core.props, puts this folder on the include path ahead of Emu.Core's, so every
     include is written "emuwin32/...", and names two folders:

     - $(EmuFrontendWin32Dir): this one.
     - $(EmuFrontendSdkDir): where the SDKs fetched or unpacked by hand are - Temp\streamline,
       Temp\fidelityfx, Temp\onnxruntime, Temp\rtxvideo, Temp\models. The solution's Temp\ unless the
       project sets it first, so two emulators can share one set. The fetch scripts put them in the
       repository that has EmuLib as its submodule. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildThisFileDirectory)..\Emu.Core\Emu.Core.props" Condition="'$(EmuCorePropsImported)'==''" />
  <PropertyGroup>
    <EmuFrontendWin32Dir>$(MSBuildThisFileDirectory)</EmuFrontendWin32Dir>
    <EmuFrontendSdkDir Condition="'$(EmuFrontendSdkDir)'==''">$(SolutionDir)Temp\</EmuFrontendSdkDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(EmuFrontendWin32Dir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
</Project>
