        </mxCell>
        <mxCell id="rec" value="&lt;b&gt;Recompiler (rec/)&lt;/b&gt;&lt;br&gt;BlockCache · BlockDecoder · BlockCompiler&lt;br&gt;page invalidation on stores" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=1;fontSize=11;" vertex="1" parent="1">
