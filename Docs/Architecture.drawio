<mxfile host="app.diagrams.net" agent="PSXEmu Docs/Architecture.md" version="24.0.0">
  <diagram id="hardware" name="PlayStation components">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title and legend -->
        <mxCell id="title" value="&lt;b&gt;PSXEmu - the emulated PlayStation&lt;/b&gt;&lt;br&gt;psx::System and its components (PSXEmu.Core/psx), and where the host plugs in" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="760" height="50" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;blue - processors&lt;br&gt;green - devices&lt;br&gt;yellow - memories&lt;br&gt;purple lines - DMA&lt;br&gt;red dashed - interrupt requests&lt;br&gt;grey dashed - the host (other threads)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1370" y="635" width="230" height="110" as="geometry" />
        </mxCell>

        <!-- Processors -->
        <mxCell id="cpu" value="&lt;b&gt;CPU - MIPS R3000A&lt;/b&gt;&lt;br&gt;33.87 MHz · interpreter or x64 recompiler&lt;br&gt;load/branch delay slots · COP0 exceptions&lt;br&gt;I-cache timing (optional)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
