  <diagram id="threads" name="Threads and data flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t_title" value="&lt;b&gt;PSXEmu - threads and the channels between them&lt;/b&gt;&lt;br&gt;each thread owns its objects; work crosses only through the channels (PSXEmu.Core/host, Docs/Threading-Plan.md)" style="text;html=1;align=left;verticalAlign=top;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="50" as="geometry" />
        </mxCell>

        <!-- Threads -->
        <mxCell id="ui" value="&lt;b&gt;UI thread - App&lt;/b&gt;&lt;br&gt;window · menus · settings windows&lt;br&gt;psxemu.ini · per-game settings&lt;br&gt;notifications · full screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="260" height="100" as="geometry" />
        </mxCell>

        <mxCell id="machine" value="&lt;b&gt;Machine thread - host::Machine&lt;/b&gt;&lt;br&gt;&lt;br&gt;requests → apply input → RunOneFrame (psx::System, until vblank)&lt;br&gt;→ PublishFrame → PumpAudio → memory cards → Pace&lt;br&gt;&lt;br&gt;FrameLimiter · SpeedResampler · display match &amp;amp; phase lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="370" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="video" value="&lt;b&gt;Video thread - VideoOutput&lt;/b&gt;&lt;br&gt;D3DPresenter → IGraphicsEngine&lt;br&gt;D3D11 · D3D12 · OpenGL · Vulkan&lt;br&gt;filters · custom chain · DLSS · FSR · overlay&lt;br&gt;vsync, or immediate (VRR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="160" width="300" height="120" as="geometry" />
        </mxCell>

        <mxCell id="audio" value="&lt;b&gt;Audio thread - AudioOutput&lt;/b&gt;&lt;br&gt;WASAPI (event-driven) or DirectSound" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="590" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="input" value="&lt;b&gt;Input thread - InputThread&lt;/b&gt;&lt;br&gt;1 kHz: keyboard · XInput&lt;br&gt;DS4 / DualSense (HID) · raw mouse&lt;br&gt;rumble out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="590" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="rast" value="&lt;b&gt;Rasteriser thread&lt;/b&gt; (gpu_thread)&lt;br&gt;SoftwareRaster, or the hardware&lt;br&gt;rasteriser's D3D11 / D3D12 device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="770" width="400" height="80" as="geometry" />
        </mxCell>

        <mxCell id="dclock" value="&lt;b&gt;Display clock thread&lt;/b&gt;&lt;br&gt;DXGI WaitForVBlank on the window's monitor&lt;br&gt;exact refresh from QueryDisplayConfig&lt;br&gt;(only for &quot;Match the display&quot;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="260" height="100" as="geometry" />
        </mxCell>

        <!-- Channels -->
        <mxCell id="c_req_m" value="RequestQueue&amp;lt;Machine&amp;gt;&lt;br&gt;settings · boot · save/load state" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="250" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_req_v" value="RequestQueue&amp;lt;VideoOutput&amp;gt;&lt;br&gt;renderer · filter · chain · vsync" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="720" y="170" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_ui" value="PostToUi&lt;br&gt;reports · status · notifications" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="380" y="90" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_mailbox" value="FrameMailbox&lt;br&gt;3 slots, newest wins&lt;br&gt;pixels or shared picture" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="330" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_ring" value="SampleRing&lt;br&gt;lock-free, held at ~40 ms" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1050" y="490" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_input" value="InputExchange&lt;br&gt;pads in · motors out" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="540" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_jobs" value="DrawJob queue&lt;br&gt;barriers before VRAM reads" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="630" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_timing" value="DisplayTiming&lt;br&gt;refresh Hz · last vblank&lt;br&gt;(sampled once a frame)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="400" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c_shared" value="Shared pictures&lt;br&gt;textures on the graphics card&lt;br&gt;(opened by the renderer)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1110" y="770" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c_skip" value="last present time · skip request&lt;br&gt;(display queue drained)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="240" width="240" height="60" as="geometry" />
        </mxCell>

        <!-- Flows -->
        <mxCell id="f1" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="c_req_m"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f2" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_req_m" target="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f3" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ui" target="c_req_v"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="320" y="200" /></Array></mxGeometry></mxCell>
        <mxCell id="f4" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_req_v" target="video"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f5" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_ui" target="ui"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f6" value="" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="machine" target="c_ui"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="120" /></Array></mxGeometry></mxCell>
        <mxCell id="f7" value="PublishFrame" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="machine" target="c_mailbox"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f8" value="TakeNew" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c_mailbox" target="video"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f9" value="PumpAudio" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="machine" target="c_ring"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f10" value="device pulls" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="c_ring" target="audio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f11" style="endArrow=classic;startArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="input" target="c_input"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f12" value="once a frame" style="endArrow=classic;startArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="c_input" target="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f13" value="GPU parses + costs" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="machine" target="c_jobs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f14" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_jobs" target="rast"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f15" value="upscaled picture" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="rast" target="c_shared"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f16" value="opened by handle /&lt;br&gt;same D3D12 device" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="c_shared" target="video"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="805" /><mxPoint x="1580" y="220" /></Array></mxGeometry></mxCell>
        <mxCell id="f17" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dclock" target="c_timing"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f18" value="" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;fontSize=10;" edge="1" parent="1" source="c_timing" target="machine"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f19" value="monitor, start/stop" style="endArrow=classic;html=1;labelBackgroundColor=#ffffff;dashed=1;fontSize=10;" edge="1" parent="1" source="ui" target="dclock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f20" style="endArrow=classic;startArrow=classic;html=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="video" target="c_skip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="f21" style="endArrow=classic;startArrow=classic;html=1;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="c_skip" target="machine"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="350" /><mxPoint x="900" y="350" /></Array></mxGeometry></mxCell>

        <mxCell id="t_note" value="&lt;b&gt;Rule:&lt;/b&gt; the machine thread never waits on a device - presenting is the video thread's, the sound device the audio thread's - so the only thing it waits for is the frame limiter." style="text;html=1;align=left;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="930" width="900" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
