          <mxGeometry x="40" y="620" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tmr" value="&lt;b&gt;Root counters 0-2&lt;/b&gt;&lt;br&gt;system clock · dot clock · hblank · clock/8&lt;br&gt;targets, wrap, sync modes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
