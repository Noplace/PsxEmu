        </mxCell>
        <mxCell id="gte" value="&lt;b&gt;GTE (COP2)&lt;/b&gt;&lt;br&gt;22 fixed-point commands&lt;br&gt;RTPS/RTPT projection · lighting · NCLIP&lt;br&gt;+ PGXP unrounded vertices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
